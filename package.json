  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@vitejs/plugin-vue": "6.0.1",
    "vite": "7.1.7",
    "firebase-tools": "14.18.0",
    "vitest": "3.2.4"
  }
}
