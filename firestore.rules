rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function roomPath(id) { return /databases/$(database)/documents/rooms/$(id); }
    function playerPath(id, uid) { return /databases/$(database)/documents/rooms/$(id)/players/$(uid); }
    function roundPath(id, rid) { return /databases/$(database)/documents/rooms/$(id)/rounds/$(rid); }
    function signedIn() { return request.auth != null; }
    function room(id) { return get(roomPath(id)).data; }
    function roomAfter(id) { return getAfter(roomPath(id)).data; }
    function round(id, rid) { return get(roundPath(id, rid)).data; }
    function roundAfter(id, rid) { return getAfter(roundPath(id, rid)).data; }
    function member(id) { return signedIn() && exists(playerPath(id, request.auth.uid)); }
    function host(id) { return signedIn() && room(id).hostUid == request.auth.uid; }
    function validScore(value) { return value in [0, 5, 10]; }
    function validLetter(value) { return value is string && value.matches('^[ء-ي]$'); }
    function validText(value) { return value is string && value.size() <= 80; }
    function validProvided(values, categories, i) { return categories.size() <= i || !values.keys().hasAny([categories[i]]) || validText(values[categories[i]]); }
    function present(values, categories, i) { return categories.size() <= i || (values.keys().hasAny([categories[i]]) && values[categories[i]].size() > 0); }
    function validAnswerMap(values, categories) { return values is map && categories.size() <= 10 && values.keys().hasOnly(categories) && validProvided(values,categories,0) && validProvided(values,categories,1) && validProvided(values,categories,2) && validProvided(values,categories,3) && validProvided(values,categories,4) && validProvided(values,categories,5) && validProvided(values,categories,6) && validProvided(values,categories,7) && validProvided(values,categories,8) && validProvided(values,categories,9); }
    function completeAnswers(values, categories) { return validAnswerMap(values,categories) && values.keys().hasAll(categories) && present(values,categories,0) && present(values,categories,1) && present(values,categories,2) && present(values,categories,3) && present(values,categories,4) && present(values,categories,5) && present(values,categories,6) && present(values,categories,7) && present(values,categories,8) && present(values,categories,9); }
    function validPlayerScores(scores, categories) { return scores is list && scores.size()==categories.size() && scores.hasOnly([0,5,10]); }
    function validAllPlayers(scores, players, categories) { return scores is map && scores.keys().hasOnly(players) && scores.keys().hasAll(players) && (players.size()<1 || validPlayerScores(scores[players[0]],categories)) && (players.size()<2 || validPlayerScores(scores[players[1]],categories)) && (players.size()<3 || validPlayerScores(scores[players[2]],categories)) && (players.size()<4 || validPlayerScores(scores[players[3]],categories)) && (players.size()<5 || validPlayerScores(scores[players[4]],categories)) && (players.size()<6 || validPlayerScores(scores[players[5]],categories)) && (players.size()<7 || validPlayerScores(scores[players[6]],categories)) && (players.size()<8 || validPlayerScores(scores[players[7]],categories)) && (players.size()<9 || validPlayerScores(scores[players[8]],categories)) && (players.size()<10 || validPlayerScores(scores[players[9]],categories)); }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.code == roomId && request.resource.data.status == 'lobby' && request.resource.data.playerCount == 1 && request.resource.data.readyCount == 1 && request.resource.data.playerUids == [request.auth.uid] && request.resource.data.maxPlayers == 10 && request.resource.data.roundNumber == 0 && request.resource.data.categories.size() >= 2 && request.resource.data.categories.size() <= 10;
      allow update: if signedIn() && (
        (host(roomId) && resource.data.status == 'lobby' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','totalRounds','durationSeconds','categories','letterMode','instantStopEnabled','updatedAt']) && request.resource.data.categories.size()>=2 && request.resource.data.categories.size()<=10)
        || (resource.data.status == 'lobby' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount','playerUids','updatedAt']) && request.resource.data.playerCount == resource.data.playerCount + 1 && request.resource.data.playerCount <= 10 && request.resource.data.playerUids.size() == resource.data.playerUids.size()+1 && request.resource.data.playerUids.hasAll(resource.data.playerUids) && !resource.data.playerUids.hasAny([request.auth.uid]) && request.resource.data.playerUids.hasAny([request.auth.uid]) && getAfter(playerPath(roomId,request.auth.uid)).data.uid == request.auth.uid)
        || (resource.data.status == 'lobby' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readyCount','updatedAt']) && get(playerPath(roomId,request.auth.uid)).data.ready != getAfter(playerPath(roomId,request.auth.uid)).data.ready && request.resource.data.readyCount == resource.data.readyCount + (getAfter(playerPath(roomId,request.auth.uid)).data.ready == true ? 1 : -1))
        || (host(roomId) && resource.data.status in ['lobby','results'] && request.resource.data.status == 'preparing' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','roundNumber','currentRoundId','usedLetters','updatedAt']) && request.resource.data.roundNumber == resource.data.roundNumber+1 && request.resource.data.roundNumber <= resource.data.totalRounds && resource.data.playerCount >= 2 && (resource.data.status!='lobby' || resource.data.readyCount==resource.data.playerCount) && (resource.data.status!='results' || round(roomId,resource.data.currentRoundId).status=='finalized') && request.resource.data.usedLetters.size()==resource.data.usedLetters.size()+1 && request.resource.data.usedLetters.hasAll(resource.data.usedLetters) && !resource.data.usedLetters.hasAny([roundAfter(roomId,request.resource.data.currentRoundId).letter]) && request.resource.data.usedLetters.hasAny([roundAfter(roomId,request.resource.data.currentRoundId).letter]) && roundAfter(roomId,request.resource.data.currentRoundId).status=='preparing')
        || (member(roomId) && resource.data.status=='preparing' && request.resource.data.status=='playing' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && roundAfter(roomId,resource.data.currentRoundId).status=='answering')
        || (member(roomId) && resource.data.status=='playing' && request.resource.data.status=='review' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && roundAfter(roomId,resource.data.currentRoundId).status=='reviewing')
        || (host(roomId) && resource.data.status=='review' && request.resource.data.status=='results' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && roundAfter(roomId,resource.data.currentRoundId).status=='finalized')
      );
      allow delete: if false;

      match /players/{playerId} {
        allow get: if signedIn() && (playerId == request.auth.uid || member(roomId));
        allow list: if member(roomId);
        allow create: if signedIn() && playerId==request.auth.uid && request.resource.data.uid==playerId && request.resource.data.keys().hasOnly(['uid','nickname','avatar','ready','connected','joinedAt','lastSeenAt']) && ((roomAfter(roomId).hostUid==playerId && roomAfter(roomId).playerCount==1 && request.resource.data.ready==true) || (exists(roomPath(roomId)) && roomAfter(roomId).playerCount==room(roomId).playerCount+1 && request.resource.data.ready==false));
        allow update: if playerId==request.auth.uid && request.resource.data.uid==resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','avatar','ready','connected','lastSeenAt']) && (request.resource.data.ready==resource.data.ready || (room(roomId).status=='lobby' && roomAfter(roomId).readyCount==room(roomId).readyCount+(request.resource.data.ready==true?1:-1)));
        allow delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if member(roomId);
        allow create: if host(roomId) && roomAfter(roomId).currentRoundId==roundId && request.resource.data.status=='preparing' && request.resource.data.number==roomAfter(roomId).roundNumber && request.resource.data.categories==room(roomId).categories && request.resource.data.durationSeconds==room(roomId).durationSeconds && validLetter(request.resource.data.letter) && !room(roomId).usedLetters.hasAny([request.resource.data.letter]) && request.resource.data.startedAt==request.time && request.resource.data.deadline==null && request.resource.data.createdBy==request.auth.uid;
        allow update: if (
          member(roomId) && resource.data.status=='preparing' && request.resource.data.status=='answering' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deadline']) && request.resource.data.deadline==resource.data.startedAt+duration.value(resource.data.durationSeconds,'s') && roomAfter(roomId).status=='playing'
        ) || (
          member(roomId) && resource.data.status=='answering' && request.resource.data.status=='reviewing' && request.resource.data.stopReason=='timer' && request.resource.data.lockedAt==request.time && request.time>=resource.data.deadline && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','lockedAt','stopReason']) && roomAfter(roomId).status=='review'
        ) || (
          member(roomId) && resource.data.status=='answering' && request.resource.data.status=='reviewing' && request.resource.data.stopReason=='harfana' && request.resource.data.stoppedBy==request.auth.uid && request.resource.data.stoppedAt==request.time && request.time<resource.data.deadline && room(roomId).instantStopEnabled==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','stoppedBy','stoppedAt','stopReason']) && completeAnswers(getAfter(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)/answers/$(request.auth.uid)).data.values,room(roomId).categories) && roomAfter(roomId).status=='review'
        ) || (
          host(roomId) && resource.data.status=='reviewing' && request.resource.data.status=='finalized' && request.resource.data.finalizedAt==request.time && request.resource.data.finalizedBy==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finalizedAt','finalizedBy']) && getAfter(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)/results/final).data.approvedBy==request.auth.uid && roomAfter(roomId).status=='results'
        );
        allow delete: if false;

        match /answers/{playerId} {
          allow read: if signedIn() && (playerId==request.auth.uid || (host(roomId) && round(roomId,roundId).status in ['reviewing','finalized']) || (member(roomId) && round(roomId,roundId).status=='finalized'));
          allow create, update: if signedIn() && playerId==request.auth.uid && request.resource.data.uid==playerId && request.resource.data.updatedAt==request.time && request.resource.data.keys().hasOnly(['uid','values','updatedAt']) && validAnswerMap(request.resource.data.values,room(roomId).categories) && ((round(roomId,roundId).status=='answering' && roundAfter(roomId,roundId).status=='answering' && request.time<round(roomId,roundId).deadline) || (round(roomId,roundId).status=='answering' && roundAfter(roomId,roundId).status=='reviewing' && roundAfter(roomId,roundId).stoppedBy==request.auth.uid && completeAnswers(request.resource.data.values,room(roomId).categories)));
          allow delete: if false;
        }
        match /results/{resultId} {
          allow read: if member(roomId);
          allow create: if resultId=='final' && host(roomId) && round(roomId,roundId).status=='reviewing' && roundAfter(roomId,roundId).status=='finalized' && request.resource.data.keys().hasOnly(['roundId','scores','approvedBy','finalizedAt']) && request.resource.data.roundId==roundId && request.resource.data.approvedBy==request.auth.uid && request.resource.data.finalizedAt==request.time && validAllPlayers(request.resource.data.scores,room(roomId).playerUids,room(roomId).categories);
          allow update, delete: if false;
        }
      }
    }
  }
}
